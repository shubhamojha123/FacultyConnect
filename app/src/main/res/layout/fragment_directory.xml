<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_margin="12dp" android:hint="Search name, department, designation, subject"
        app:boxCornerRadiusBottomEnd="24dp" app:boxCornerRadiusBottomStart="24dp"
        app:boxCornerRadiusTopEnd="24dp" app:boxCornerRadiusTopStart="24dp"
        app:startIconDrawable="@drawable/ic_search">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearch" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="text" android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFaculty"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:paddingBottom="16dp" />
        <include android:id="@+id/stateView" layout="@layout/view_state"
            android:layout_width="match_parent" android:layout_height="match_parent" />
    </FrameLayout>
</LinearLayout>
